{
  "name": "quantum-lab-3d",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run test:console",
    "validate": "npm run test:all && npm run build",
    "test:console": "playwright test tests/e2e/console-audit.spec.ts",
    "test:visual": "RUN_VISUAL=1 playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "RUN_VISUAL=1 playwright test tests/e2e/visual-regression.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^14.2.35",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
